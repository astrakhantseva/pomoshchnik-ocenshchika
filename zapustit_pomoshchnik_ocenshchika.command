#!/bin/bash
# =====================================================================
#  ENCODING: UTF-8. Файлу нужны права на исполнение:
#      chmod +x "zapustit_pomoshchnik_ocenshchika.command"
#  Пара к файлу «zapustit_pomoshchnik_ocenshchika.bat» для Windows.
# =====================================================================
cd "$(dirname "$0")" || exit 1

echo
echo "  ======================================"
echo "     Помощник оценщика"
echo "  ======================================"
echo

# --- Уже запущено? Тогда просто открываем окно в браузере ---------------
if lsof -nP -iTCP:8501 -sTCP:LISTEN >/dev/null 2>&1; then
    echo "  Приложение уже работает - открываю его в браузере."
    open "http://localhost:8501"
    sleep 3
    exit 0
fi

# --- Есть ли на компьютере Python ---------------------------------------
if ! command -v python3 >/dev/null 2>&1; then
    echo "  [!] На этом компьютере не найден Python."
    echo
    echo "      Установите его с сайта python.org, а после установки"
    echo "      запустите этот значок ещё раз."
    echo
    read -n 1 -s -r -p "  Нажмите любую клавишу, чтобы закрыть окно."
    exit 1
fi

# --- Есть ли нужные библиотеки -------------------------------------------
if ! python3 -c "import streamlit, curl_cffi, openpyxl, docx" >/dev/null 2>&1; then
    echo "  Первый запуск: доустанавливаю нужные библиотеки."
    echo "  Это займёт несколько минут. Дальше запуск будет быстрым."
    echo
    if ! python3 -m pip install --disable-pip-version-check \
            streamlit curl_cffi openpyxl python-docx Pillow; then
        echo
        echo "  [!] Библиотеки установить не удалось."
        echo "      Проверьте интернет и попробуйте ещё раз."
        echo
        read -n 1 -s -r -p "  Нажмите любую клавишу, чтобы закрыть окно."
        exit 1
    fi
    echo
fi

# --- Убираем разовый вопрос Streamlit про электронную почту ---------------
# Без этого файла программа при первом запуске спрашивает адрес почты
# и ждёт ответа в этом окне, а браузер так и не открывается.
if [ ! -f "$HOME/.streamlit/credentials.toml" ]; then
    mkdir -p "$HOME/.streamlit"
    printf '[general]\nemail = ""\n' > "$HOME/.streamlit/credentials.toml"
fi

echo "  Запускаю. Через несколько секунд откроется вкладка в браузере."
echo
echo "  ----------------------------------------------------------"
echo "   ВАЖНО: не закрывайте это окно, пока работаете с программой."
echo "   Чтобы закончить работу - просто закройте его."
echo "  ----------------------------------------------------------"
echo

python3 -m streamlit run app.py

echo
echo "  Приложение остановлено."
read -n 1 -s -r -p "  Нажмите любую клавишу, чтобы закрыть окно."
